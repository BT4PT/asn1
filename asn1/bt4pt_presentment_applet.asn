/**
* Data structures of the APDU presentation of a BT4PT envelope by a Presentment Device.
*/
BT4PT-PresentmentAppletV1-0 {
    iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) uic(17218) fcb(1) bt4pt(2) presentmentApplet(13) v1(1) 0
} DEFINITIONS ::= BEGIN

EXPORTS PresentmentAppletInfo;

/**
* The response data of a successful SELECT of the presentment applet, encoded per the Distinguished Encoding Rules.
*/
PresentmentAppletInfo ::= SEQUENCE {
    /**
    * The protocols and optional features supported by the Presentment Device.
    * The list **SHALL** contain an entry for each feature implemented by the Presentment and **SHALL NOT** contain
    * more than one entry with the same `id`.
    * A Ticket Inspection Device **SHALL** ignore any entry whose `id` it does not recognise.
    *
    * The base specification is identified with the OID `1.3.6.1.4.1.17218.1.3.1.1`.
    */
    supportedFeatures   SEQUENCE OF SupportedFeature
}

/**
* A protocol or optional feature supported by the Presentment Device.
*/
SupportedFeature ::= SEQUENCE {
    /**
    * The object identifier of the protocol or optional feature.
    */
    id                  OBJECT IDENTIFIER,
    /**
    * Auxiliary data for the protocol or optional feature, whose contents are defined by the specification of the 
    * protocol or optional feature identified by `id`. Where that specification defines no auxiliary data, this field
    * **SHALL** be absent, and a Ticket Inspection Device **SHALL** ignore it if present.
    */
    auxiliaryData       OCTET STRING OPTIONAL
}

END
